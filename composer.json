{
    "name": "progrmanial/fast-api",
    "description": "Standardised API Management Package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Imran Saadullah",
            "email": "imransaadullah@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "firebase/php-jwt": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "FASTAPI\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "ext-redis": "Faster rate-limit storage; FASTAPI falls back to file storage when the extension is missing"
    }
}
